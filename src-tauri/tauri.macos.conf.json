{
  "build": {
    "beforeDevCommand": "npm run helper && npm run dev",
    "beforeBuildCommand": "npm run helper && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "reader",
        "url": "reader.html",
        "title": "Wordstrobe",
        "width": 520,
        "height": 190,
        "minWidth": 360,
        "minHeight": 140,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visibleOnAllWorkspaces": true,
        "shadow": true,
        "windowEffects": { "effects": ["hudWindow"], "radius": 14 }
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "Wordstrobe Settings",
        "width": 560,
        "height": 640,
        "visible": false
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "externalBin": ["binaries/wordstrobe-ocr"],
    "macOS": { "minimumSystemVersion": "15.0", "signingIdentity": "-" }
  }
}

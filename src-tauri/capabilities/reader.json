{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "reader",
  "description": "Reader popup: receive events from Rust, drag/hide/resize itself, read settings. No shell, no clipboard yet.",
  "windows": ["reader"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-hide",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "store:allow-load",
    "store:allow-get-store",
    "store:allow-get",
    "store:allow-has",
    "store:allow-keys",
    "store:allow-values",
    "store:allow-entries",
    "store:allow-length"
  ]
}
